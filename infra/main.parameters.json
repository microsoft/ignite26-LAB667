{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "modelLocation": { "value": "${AGENT42_MODEL_LOCATION=}" },
    "modelName": { "value": "${AGENT42_MODEL_NAME=gpt-5.6-luna}" },
    "modelVersion": { "value": "${AGENT42_MODEL_VERSION=2026-07-09}" },
    "modelSku": { "value": "${AGENT42_MODEL_SKU=GlobalStandard}" },
    "modelCapacity": { "value": "${AGENT42_MODEL_CAPACITY=10}" },
    "mcpImage": { "value": "${SERVICE_MCP_IMAGE_NAME=}" },
    "dashboardImage": { "value": "${SERVICE_DASHBOARD_IMAGE_NAME=}" },
    "adminImage": { "value": "${SERVICE_ADMIN_IMAGE_NAME=}" },
    "agent42Image": { "value": "${SERVICE_AGENT42_IMAGE_NAME=}" }
  }
}
