AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_DEPLOYMENT_NAME=<your-main-agent-deployment>

# Optional city-guide model. Blank reuses AZURE_OPENAI_DEPLOYMENT_NAME.
CITY_GUIDE_AZURE_OPENAI_DEPLOYMENT_NAME=

# Foundry IQ knowledge base. The MCP endpoint needs a Search admin key.
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_KNOWLEDGE_BASE_NAME=san-francisco-cityguide
AZURE_SEARCH_KEY=<your-azure-ai-search-admin-key>

GAME_MCP_URL=https://<deployed-game-host>/san-francisco/mcp
GAME_API_KEY=<copy-from-the-player-page>
AGENT42_URL=https://<your-agent42-host>/
AGENT42_TIMEOUT_SECONDS=60
