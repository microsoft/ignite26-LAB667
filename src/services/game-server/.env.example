# Azure Storage account for game state (games, quests, players).
# Use Azurite locally with: AZURE_TABLES_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_TABLES_CONNECTION_STRING=

# The San Francisco seed can be renamed; Philadelphia is also seeded when missing.
DEFAULT_GAME_SLUG=san-francisco
DEFAULT_GAME_NAME=Lost in San Francisco
DEFAULT_EVENT_NAME=Microsoft Ignite

# MCP server bind address and port. Each game is mounted at /<slug>/mcp.
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Public URLs for admin links and per-game workshop instruction variables.
# Set GAME_SERVER_URL and AGENT42_URL on both admin and dashboard deployments.
GAME_SERVER_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:8090
AGENT42_URL=http://localhost:8042

# Admin UI port (separate process).
ADMIN_PORT=8080
# Local HTTP only. Keep true (the default) for HTTPS deployments.
ADMIN_COOKIE_SECURE=false
# Local development only. Never enable this in a deployed environment.
ADMIN_DEVELOPMENT_MODE=true

# Optional route JSON blob settings used by the dashboard animation proxy.
# If MOVE_ROUTES_BASE_URL is empty, it is inferred from the storage account.
MOVE_ROUTES_BASE_URL=
MOVE_BLOB_CONNECTION_STRING=
MOVE_BLOB_CONTAINER=move-routes

# Shared by the public dashboard and authenticated admin maps/address lookup.
AZURE_MAPS_KEY=