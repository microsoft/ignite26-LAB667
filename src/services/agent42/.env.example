# --- Azure Maps --------------------------------------------------------------
# Create an Azure Maps account in the Azure portal and copy a shared key:
# https://learn.microsoft.com/azure/azure-maps/how-to-manage-authentication
AZURE_MAPS_KEY=your-azure-maps-shared-key

# --- Model (pick ONE option) -------------------------------------------------
# Option A: Azure AI Foundry (uses `az login` for auth)
AZURE_AI_FOUNDRY_DEPLOYMENT=
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=


# Option B: Azure OpenAI with an API key
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=

# --- Server ------------------------------------------------------------------
AGENT42_HOST=0.0.0.0
AGENT42_PORT=8042
# Public URL advertised in the A2A AgentCard; defaults to http://HOST:PORT
AGENT42_PUBLIC_URL=
# Optional "lon,lat" point used to nudge geocoding toward a specific city
# when callers give short, ambiguous names (e.g. "Chinatown"). Leave blank
# for fully global behavior.
AGENT42_GEOCODE_BIAS=

# --- Blob Storage for rendered route maps + directions ----------------------
# Connection string for the Azure Storage account that holds rendered route
# PNGs and their turn-by-turn JSON. The container is created automatically
# with public-blob access on first use.
AGENT42_BLOB_CONNECTION_STRING=
AGENT42_BLOB_CONTAINER=agent42-routes
# Readable map / directions URLs use SAS tokens when the connection string
# includes an account key. Default expiry is 168 hours (7 days).
AGENT42_BLOB_SAS_EXPIRY_HOURS=168
