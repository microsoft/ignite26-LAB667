{
  "name": "Lost in San Francisco",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "os-provided",
      "installTools": false
    },
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "installBicep": true
    },
    "ghcr.io/azure/azure-dev/azd:latest": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "dockerDashComposeVersion": "v2"
    }
  },
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.azure-dev",
        "ms-azuretools.vscode-bicep",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/python/current/bin/python"
      }
    }
  },
  "forwardPorts": [8000, 8090, 8080, 8042],
  "portsAttributes": {
    "8000": {
      "label": "Game MCP server",
      "onAutoForward": "silent"
    },
    "8090": {
      "label": "Game dashboard",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Game admin (sign-in required)",
      "onAutoForward": "notify"
    },
    "8042": {
      "label": "Agent42 A2A",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "python --version && az version && az bicep version && azd version && docker --version && docker compose version"
}
